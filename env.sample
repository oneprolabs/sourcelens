# SourceLens deployment inputs. Copy to .env (production) or .env.dev (development).
# Replace placeholder secrets. Never commit real credentials.

# Public URLs: replace these together for your domain/protocol.
SECRET_KEY=change-me
SITE_DOMAIN=localhost:8000
SITE_NAME=SourceLens
FRONTEND_URL=http://localhost:3000
ACCOUNT_DEFAULT_HTTP_PROTOCOL=http
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DJANGO_DEBUG=true

# Docker ports (defaults shown; uncomment only to change).
# DJANGO_HOST_PORT=8000
# FLOWER_HOST_PORT=5555
# NGINX_HTTP_PORT=10080
# NGINX_HTTPS_PORT=10443

# Keep database identity explicit; do not change POSTGRES_DB on an existing install.
DB_ENGINE=postgresql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sourcelens
POSTGRES_HOST=postgresql
# POSTGRES_PORT=5432
# DATABASE_URL overrides DB_ENGINE for an external database.
# DATABASE_URL=postgresql://postgres:password@db.example.com:5432/sourcelens

# One shared Redis address for Celery. A separate broker remains optional.
REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://separate-broker:6379/0
# Cache derives database 1 from REDIS_URL; channels stay on database 2.
# CACHE_REDIS_URL=redis://redis:6379/1
CHANNEL_LAYER_REDIS_URL=redis://redis:6379/2
# CELERY_CONCURRENCY=4
# CELERY_TASK_DEFAULT_QUEUE=backend

# Shared node identity. Compose owns container paths and service endpoints.
LENSNODE_NAME=local-dev-lensnode
LENSNODE_TOKEN=change-me-lensnode-token
# LENSNODE_MAX_CONCURRENT_RUNS=8

# Initial administrator.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpassword

# SMTP (TLS is explicit because it is not the application default).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@sourcelens.local

# Turnstile is enabled by default in production; development Compose disables it.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_BYPASS_IPS=

# Optional integrations. Set only the services you use.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SENTRY_ENABLED=true
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_OTEL_HOST=https://your-langfuse-host
# VITE_GA_ID=
