{
  "key": "github",
  "version": "1.0.0",
  "protocol_version": 1,
  "capability_family": "plugin",
  "display_name": "GitHub",
  "icon": "assets/icon.svg",
  "description": "Connect GitHub.com repositories for file sync and read-only assistant queries.",
  "assistant_guidance": {
    "summary": "Use GitHub tools to inspect approved repositories, code, issues, pull requests, releases, and Actions metadata.",
    "when_to_use": [
      "The user asks for current information from an approved GitHub repository.",
      "The user asks to inspect repository code, issues, pull requests, releases, or workflow runs."
    ],
    "topics": [
      {
        "key": "repository",
        "summary": "Start with repository metadata, branches, commits, or a bounded file read.",
        "details": "Use repository in owner/name form. Read only approved repositories. Use a branch, tag, or commit SHA when the user identifies a revision. Keep file reads bounded and prefer repository metadata before deeper inspection.",
        "tool_keys": [
          "github_repository_get",
          "github_branch_list",
          "github_commit_list",
          "github_commit_get",
          "github_read_file"
        ]
      },
      {
        "key": "code_search",
        "summary": "Search code inside one approved repository and then read relevant files.",
        "details": "Search terms must not include repo:, org:, or user: qualifiers. The repository argument is the only scope selector. Use the returned paths with github_read_file when source context is needed.",
        "tool_keys": ["github_search_code", "github_read_file"]
      },
      {
        "key": "issues_and_pull_requests",
        "summary": "Inspect activity, issue and pull request metadata, comments, files, and reviews.",
        "details": "For a time-bounded activity report across one or more repositories, call github_activity_summary once with every approved repository instead of calling list tools per repository. Use list tools before requesting a specific item for other tasks. Fetch pull request or issue details, comments, files, and reviews only for the few matching records whose summary lacks a required report field. Never repeat the same repository, tool, and arguments.",
        "tool_keys": [
          "github_activity_summary",
          "github_issue_list",
          "github_issue_get",
          "github_issue_comments",
          "github_pull_request_list",
          "github_pull_request_get",
          "github_pull_request_files",
          "github_pull_request_reviews"
        ]
      },
      {
        "key": "releases_and_actions",
        "summary": "Review releases and GitHub Actions workflow run metadata without logs or artifacts.",
        "details": "Use releases for published version context and Actions tools for run status, branch, and conclusion. Logs, jobs, and artifacts are intentionally unavailable.",
        "tool_keys": [
          "github_release_list",
          "github_workflow_run_list",
          "github_workflow_run_get"
        ]
      }
    ]
  },
  "datasource_source_type": "git",
  "datasource": {
    "key": "github_repository",
    "display_name": "GitHub repository",
    "description": "Synchronize repository files from an explicitly authorized GitHub.com repository into a LensNode workspace. Issues and pull requests remain available through read-only tools and are not synchronized as datasource content.",
    "source_type": "git",
    "resources": [
      {
        "key": "repositories",
        "display_name": "Repositories"
      },
      {
        "key": "branches",
        "display_name": "Branches",
        "depends_on": "repositories"
      }
    ],
    "runtime": {
      "supports_incremental": true,
      "supports_cancel": true,
      "output": "workspace"
    }
  },
  "handlers": {
    "control": "python_v1",
    "runtime": "python_v1"
  },
  "connection_schema": {
    "type": "object",
    "properties": {
      "secret_value": {
        "type": "string",
        "format": "password",
        "title": "Personal access token",
        "description": "A write-only token with read access to the approved repositories.",
        "write_to": "secret_value"
      },
      "repositories": {
        "type": "array",
        "format": "provider-resource",
        "resource": "repositories",
        "title": "Allowed repositories",
        "description": "Explicit owner/repository values this connection may access.",
        "write_to": "allowed_scope.repositories",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["secret_value", "repositories"],
    "additionalProperties": false
  },
  "datasource_schema": {
    "type": "object",
    "properties": {
      "repositories": {
        "type": "array",
        "items": {"type": "string"},
        "format": "provider-resource",
        "resource": "repositories",
        "title": "Repositories",
        "minItems": 1,
        "maxItems": 50
      },
      "branch": {
        "type": "string",
        "format": "provider-resource-option",
        "resource": "branches",
        "depends_on": "repositories",
        "title": "Branch",
        "description": "Optional branch, tag, or commit ref shared by all repositories."
      },
      "directory": {
        "type": "string",
        "format": "repository-path",
        "title": "Directory",
        "description": "Optional repository-relative directory to sync."
      }
    },
    "required": ["repositories"],
    "additionalProperties": false
  },
  "tools": [
    {
      "key": "github_read_file",
      "description": "Read a UTF-8 text file from an approved GitHub repository. Use repository in owner/repository form, a repository-relative path, and optionally a branch, tag, or commit ref.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "path": {
            "type": "string",
            "description": "Repository-relative file path."
          },
          "ref": {
            "type": "string",
            "description": "Optional branch, tag, or commit SHA."
          }
        },
        "required": ["repository", "path"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_search_code",
      "description": "Search code only within an approved GitHub repository and return bounded file metadata. Do not include GitHub search qualifiers such as repo:, org:, or user: in the query.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "query": {
            "type": "string",
            "description": "Search terms without scope-changing qualifiers."
          },
          "path": {
            "type": "string",
            "description": "Optional repository-relative directory filter."
          },
          "max_results": {
            "type": "integer",
            "description": "Maximum result count from 1 through 20."
          }
        },
        "required": ["repository", "query"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_repository_get",
      "description": "Get bounded metadata for an approved GitHub repository, including its default branch, visibility, language, activity, and counts. Use this before repository-specific work when basic repository context is needed.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          }
        },
        "required": ["repository"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_activity_summary",
      "description": "Get compact commits, pull requests, and issues updated in one ISO-8601 time window across approved GitHub repositories. Use this once for activity reports instead of separate list calls per repository. Results use safe resource-specific candidate limits and omit bodies, comments, reviews, files, and patches.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repositories": {
            "type": "array",
            "description": "Approved repositories in owner/repository form.",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "Inclusive ISO-8601 lower bound."
          },
          "until": {
            "type": "string",
            "format": "date-time",
            "description": "Inclusive ISO-8601 upper bound."
          },
          "per_page": {
            "type": "integer",
            "description": "Optional candidate ceiling from 1 through 100. The runtime applies lower safe limits to body-heavy resource types. Defaults to 50; only records inside the requested window are returned.",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": ["repositories", "since", "until"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_branch_list",
      "description": "List branches in an approved GitHub repository with their head commit SHA and protection state. Results are paginated and bounded.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "page": {
            "type": "integer",
            "description": "One-based page number, from 1 through 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "per_page": {
            "type": "integer",
            "description": "Maximum items to return, from 1 through 20.",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["repository"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_commit_list",
      "description": "List commits in an approved GitHub repository. Prefer since/until for a bounded time window; optionally filter by branch, tag, or path. Results are paginated and omit patches.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "ref": {
            "type": "string",
            "description": "Optional branch, tag, or commit SHA."
          },
          "path": {
            "type": "string",
            "description": "Optional repository-relative path filter."
          },
          "since": {
            "type": "string",
            "description": "Optional ISO-8601 lower bound for commit time."
          },
          "until": {
            "type": "string",
            "description": "Optional ISO-8601 upper bound for commit time."
          },
          "page": {
            "type": "integer",
            "description": "One-based page number, from 1 through 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "per_page": {
            "type": "integer",
            "description": "Maximum items to return, from 1 through 20.",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["repository"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_commit_get",
      "description": "Get one commit from an approved GitHub repository by branch, tag, or SHA. Returns bounded commit metadata, statistics, and changed-file summaries without patches.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "ref": {
            "type": "string",
            "description": "Branch, tag, or commit SHA identifying the commit."
          }
        },
        "required": ["repository", "ref"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_issue_list",
      "description": "List issues, excluding pull requests, in an approved GitHub repository. Prefer since/until for a bounded time window; optionally filter by state and labels.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "state": {
            "type": "string",
            "description": "Issue state: open, closed, or all. Defaults to open."
          },
          "labels": {
            "type": "string",
            "description": "Optional comma-separated label names."
          },
          "since": {
            "type": "string",
            "description": "Optional ISO-8601 lower bound for issue updates."
          },
          "until": {
            "type": "string",
            "description": "Optional ISO-8601 upper bound for local filtering of issue updates."
          },
          "page": {
            "type": "integer",
            "description": "One-based page number, from 1 through 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "per_page": {
            "type": "integer",
            "description": "Maximum items to return, from 1 through 20.",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["repository"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_issue_get",
      "description": "Get one issue from an approved GitHub repository by number. Returns bounded issue metadata and body text; use github_issue_comments when comments are needed.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "number": {
            "type": "integer",
            "description": "Positive issue number.",
            "minimum": 1
          }
        },
        "required": ["repository", "number"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_issue_comments",
      "description": "List comments for one issue in an approved GitHub repository. Results are paginated and each comment body is bounded.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "number": {
            "type": "integer",
            "description": "Positive issue number.",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "description": "One-based page number, from 1 through 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "per_page": {
            "type": "integer",
            "description": "Maximum items to return, from 1 through 20.",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["repository", "number"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_pull_request_list",
      "description": "List pull requests in an approved GitHub repository. Optionally filter by state. Results are paginated and include branch and commit identities.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "state": {
            "type": "string",
            "description": "Pull request state: open, closed, or all. Defaults to open."
          },
          "page": {
            "type": "integer",
            "description": "One-based page number, from 1 through 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "per_page": {
            "type": "integer",
            "description": "Maximum items to return, from 1 through 20.",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["repository"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_pull_request_get",
      "description": "Get one pull request from an approved GitHub repository by number. Returns bounded metadata, body, branch identities, merge state, and change counts.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "number": {
            "type": "integer",
            "description": "Positive pull request number.",
            "minimum": 1
          }
        },
        "required": ["repository", "number"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_pull_request_files",
      "description": "List changed files for one pull request in an approved GitHub repository. Returns bounded file statistics without patch content.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "number": {
            "type": "integer",
            "description": "Positive pull request number.",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "description": "One-based page number, from 1 through 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "per_page": {
            "type": "integer",
            "description": "Maximum items to return, from 1 through 20.",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["repository", "number"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_pull_request_reviews",
      "description": "List reviews for one pull request in an approved GitHub repository. Results are paginated and each review body is bounded.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "number": {
            "type": "integer",
            "description": "Positive pull request number.",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "description": "One-based page number, from 1 through 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "per_page": {
            "type": "integer",
            "description": "Maximum items to return, from 1 through 20.",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["repository", "number"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_release_list",
      "description": "List releases in an approved GitHub repository. Results are paginated and include bounded release metadata without downloading assets.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "page": {
            "type": "integer",
            "description": "One-based page number, from 1 through 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "per_page": {
            "type": "integer",
            "description": "Maximum items to return, from 1 through 20.",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["repository"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_workflow_run_list",
      "description": "List GitHub Actions workflow runs in an approved repository. Optionally filter by status and branch. Results are paginated and do not include logs or artifacts.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "status": {
            "type": "string",
            "description": "Optional workflow run status or conclusion supported by GitHub."
          },
          "branch": {
            "type": "string",
            "description": "Optional branch name."
          },
          "page": {
            "type": "integer",
            "description": "One-based page number, from 1 through 1000.",
            "minimum": 1,
            "maximum": 1000
          },
          "per_page": {
            "type": "integer",
            "description": "Maximum items to return, from 1 through 20.",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": ["repository"],
        "additionalProperties": false
      }
    },
    {
      "key": "github_workflow_run_get",
      "description": "Get one GitHub Actions workflow run in an approved repository by run ID. Returns bounded run metadata without logs, jobs, or artifacts.",
      "capability": "repository.read",
      "side_effect": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "description": "Approved repository in owner/repository form."
          },
          "run_id": {
            "type": "integer",
            "description": "Positive workflow run ID.",
            "minimum": 1
          }
        },
        "required": ["repository", "run_id"],
        "additionalProperties": false
      }
    }
  ]
}
